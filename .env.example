# ApnaGhar local configuration. Run python scripts/setup_local.py.
# Keep real keys in .env only; never commit credentials.

# Required database: use your SERVER-ONLY service-role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KEY=

# Configure at least ONE AI provider (Gemini -> Groq -> OpenRouter).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Generated locally by setup_local.py.
JWT_SECRET=
ADMIN_SESSION_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
PUBLIC_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=
ENABLE_SCHEDULER=true

# Optional email OTP and notifications (Gmail app password).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GOOGLE_OAUTH_CLIENT_ID=

# Optional Telegram. Polling works locally; webhooks require public HTTPS.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Optional WhatsApp Cloud API; webhooks require public HTTPS.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_BUSINESS_NUMBER=
BROKER_WHATSAPP_PHONE=

# Optional Calendar. Share this calendar with the service-account email.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
BROKER_GOOGLE_CALENDAR_ID=
# Legacy Calendar aliases (prefer the three settings above).
GOOGLE_CALENDAR_SERVICE_ACCOUNT=
GOOGLE_CALENDAR_ID=

# Optional SMS and n8n.
FAST2SMS_API_KEY=
N8N_LEAD_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Patna market metadata; application coverage is defined in city_config.py.
TARGET_CITY=Patna
TARGET_AREAS=Boring Road,Kankarbagh,Bailey Road,Danapur,Patliputra Colony

# Optional geocoding providers (see usage restrictions in docs/PATNA.md).
GEOCODER_USER_AGENT=ApnaGhar-Patna/1.0
NOMINATIM_DOMAIN=nominatim.openstreetmap.org
PHOTON_URL=https://photon.komoot.io/api
OVERPASS_URL=https://overpass-api.de/api/interpreter
